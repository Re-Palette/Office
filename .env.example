# ── Live AI employees ───────────────────────────────────────────────────────
# Without a key the dashboard runs in demo mode: AI activity is simulated and
# no API calls are made. With one, AI employees actually run — they call the
# model, use tools, and write their results back into the company state.
#
# 接続先は3つから選べます。切り替えはこのファイルだけで完結し、コードは
# 触りません。キーを入れるだけで自動判定されるので、通常は FRIDAY_PROVIDER を
# 書く必要はありません。
#
#   gemini     … Google Gemini（無料枠あり・既定）
#   anthropic  … Anthropic Claude（有料・品質最優先のとき）
#   openai     … OpenAI互換のエンドポイント全般
#                （OpenAI / Groq / DeepSeek / OpenRouter / Together /
#                  Vercel AI Gateway / ローカルのOllama など）
#
# FRIDAY_PROVIDER=gemini

# ── 1. Gemini（既定・無料枠あり）────────────────────────────────────────────
# 取得: https://aistudio.google.com/apikey （Googleアカウントのみ・カード不要）
GEMINI_API_KEY=
# GOOGLE_API_KEY でも同じ値として受け付けます。

# 既定はすべて Flash-Lite です。いちばん安く、1日あたりの回数もいちばん多い
# ので、無料枠だけで回すならこれが基準になります（Pro は有料のみ）。
#
# 3.5 ではなく 3.1 を既定にしている理由:
#   ・2.5系からの公式な移行先であること
#   ・preview ではなく stable であること
#   ・3.5-flash-lite より安いこと（$0.25/$1.5 と $0.30/$2.50）
#   ・無料枠の数値（30 RPM / 1,500 RPD）が公開されていること
# 新しいほうを使いたいなら 1行変えるだけです: GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite
# 委譲された作業を担当する専門職のモデル。
GEMINI_WORKER_MODEL=gemini-3.1-flash-lite
# web_search / code_execution の内部呼び出しに使うモデル。1ターンで複数回
# 走ることがあります。
GEMINI_SEARCH_MODEL=gemini-3.1-flash-lite

# ⚠️ モデルIDは短い周期で廃止されます。gemini-2.5-flash-lite は 2026/10/16 に
# 停止予定で、それ以前から新規プロジェクトには404を返していました。
# このアプリは404を受けたら利用可能なモデル一覧を引いて、同じ価格帯の最新版へ
# 自動で切り替えます（切り替わったことは /api/diagnose に出ます）。
# 止まりはしませんが、出ていたらここを更新してください。

# 役員だけ賢くしたい場合は、ここだけ上げてください（枠の消費は増えます）:
# GEMINI_MODEL=gemini-3.6-flash

# ── 2. Claude に戻す場合 ────────────────────────────────────────────────────
# これを設定すれば接続先はClaudeになります（FRIDAY_PROVIDER は不要）。
# ANTHROPIC_API_KEY=
# モデルの既定値は claude-opus-5 / claude-sonnet-5 です。変えるなら:
# FRIDAY_MODEL=claude-opus-5
# FRIDAY_WORKER_MODEL=claude-sonnet-5

# ── 3. OpenAI互換のエンドポイントを使う場合 ─────────────────────────────────
# OPENAI_API_KEY=
# FRIDAY_PROVIDER=openai
# 接続先のURL。ここを変えるだけで別サービスに切り替わります。
#   OpenAI    … https://api.openai.com/v1
#   Groq      … https://api.groq.com/openai/v1
#   DeepSeek  … https://api.deepseek.com/v1
#   OpenRouter… https://openrouter.ai/api/v1
#   Ollama    … http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ダッシュボードでの表示名。
# OPENAI_LABEL=OpenAI
# この接続先ではモデル名を推測できないため、必須です。
# FRIDAY_MODEL=

# ── 接続先をまたぐ設定 ──────────────────────────────────────────────────────
# どのモデルが自分のキーで使えるかは /api/diagnose で一覧できます。
# 接続先・選ばれた理由・切り替え可能な候補もそこに出ます。

# OpenAI互換のエンドポイントにはWeb検索機能がありません。GEMINI_API_KEY が
# あれば「検索だけGeminiに借りる」ことができます（未設定なら自動でそうします）。
# off にすると検索ツールそのものを配布しません。
# FRIDAY_SEARCH_PROVIDER=gemini

# 思考（推論）の深さ: off / low / medium / high
# 思考トークンは出力として計上され、1分あたりのトークン上限も消費するため、
# 無料枠では二重に効きます。既定は low（ツール呼び出しの計画には十分）。
GEMINI_THINKING=low
# 1ターンの出力上限。
GEMINI_MAX_OUTPUT_TOKENS=4096

# Real web search / page reading for the research-capable employees.
# web_search は接続先の検索機能を1回呼び出します。
# web_fetch はこのサーバーが直接取得するため、どの接続先でもAPIを消費しません。
FRIDAY_WEB_TOOLS=true
# Real code execution for the analysis-capable employees.
FRIDAY_CODE_EXECUTION=true

# ── 無料枠だけで回すための歯止め ────────────────────────────────────────────
# 接続先が gemini のとき自動で有効になります。false で無効（有料キー向け）。
FRIDAY_FREE_TIER=true

# 1日に送るリクエストの自主上限。これに達すると、その日はAI社員を実行しません。
# Flash-Lite の無料枠は 1,500リクエスト/日・30リクエスト/分とされているので、
# 既定値はその約1/3と1/2です。通常の1日では到達せず、かつ数値が違っていても
# 1日を失わない余裕を取っています。
# 本当の上限はAPIが429で「1日の上限に達した」と返した時点で学習し、その日は
# それ以上送りません（推測しません）。リセットは太平洋時間の0時（日本時間17時ごろ）。
FRIDAY_DAILY_REQUEST_BUDGET=500

# 1分あたりの上限。これに近づくと自動で待機します（429で実行が壊れるより、
# 数秒待つほうが安いため）。
FRIDAY_REQUESTS_PER_MINUTE=15

# Safety rails on a single run.
# ループの1ステップ = APIリクエスト1回です。委譲は1件ごとに子の実行が丸ごと
# 走り、web_search は1回ごとに内部呼び出しが1回増えます。つまり1つの指示が
# 30リクエストになることがあり、ここがその歯止めです。
FRIDAY_MAX_STEPS=12
FRIDAY_MAX_DELEGATIONS=3

# Where the company's working state is persisted (relative to the project root).
FRIDAY_DATA_DIR=.friday

# ── 外部エージェント（副社長 FRIDAY）からの操作 ──────────────────────────────
# CEOの秘書として動く別のAIエージェントに、この会社を読ませ・操作させるための
# トークンです。設定するまで /api/mcp は 503 を返します。
#
# 生成:  openssl rand -hex 32
# 32文字未満は拒否されます（推測できる文字列は鍵ではないため）。
FRIDAY_AGENT_TOKEN=

# 権限。既定は read,operate です。
#   read     … 状況・タスク・承認待ち・レポートを読む
#   operate  … 会社へ指示を出す、質問する、定期ジョブを即実行する、時刻を変える
#   approve  … 承認を実行する（＝取り消せない操作が外に出る）
#
# approve は既定で付きません。operate までなら、どう指示されても承認ゲートで
# 止まるため、外部に出ていくものはありません。approve を付けると、
# エージェントがCEOの代わりにメール送信などを確定できるようになります。
# FRIDAY_AGENT_SCOPES=read,operate

# Claude Code 側の接続（FRIDAY のマシンで1回だけ）:
#   claude mcp add --transport http friday-company \
#     https://<あなたのドメイン>/api/mcp \
#     --header "Authorization: Bearer <FRIDAY_AGENT_TOKEN>"
#
# 疎通確認:  curl -H "Authorization: Bearer <token>" https://<domain>/api/mcp

# ── Google（Gmail + Calendar）─────────────────────────────────────────────
# 設定すると、email / calendar を持つAI社員が実際に受信箱とカレンダーを読み、
# CEOの承認を経てメール送信と打ち合わせ設定を行います。未設定なら該当ツールは
# 配布されず、他の機能はそのまま動きます。
#
# 取得手順（Settings 画面にも同じ手順があります）:
#  1. console.cloud.google.com でプロジェクトを作り、Gmail API と
#     Google Calendar API を有効化する
#  2. OAuth 同意画面を設定し、自分のアカウントをテストユーザーに追加する
#  3. 認証情報 → OAuth クライアントID（デスクトップアプリ）を作成する
#  4. 次のスコープでリフレッシュトークンを取得する:
#       https://www.googleapis.com/auth/gmail.readonly
#       https://www.googleapis.com/auth/gmail.send
#       https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 送信元アドレス。空なら認証したアカウントのアドレスが使われます。
# 表示名を付けるなら: Re-Palette <you@example.com>
GOOGLE_SEND_AS=
# 使用するカレンダー。既定は認証したアカウントのメインカレンダー。
GOOGLE_CALENDAR_ID=primary

# ── note（記事の自動執筆）──────────────────────────────────────────────────
# 設定不要で動きます。Content AI が毎日 NOTE_DAILY_DRAFT_AT（JST）に記事を1本書き、
# Markdown の文書ファイルとして保存します。ダッシュボードの NOTE DRAFTS から
# 全文をコピーするか .md をダウンロードして、note に貼り付けてください。
NOTE_DAILY_DRAFT_AT=17:00

# 出力先。note には記事投稿の公式APIがないため、既定は file です。
#   file    … 文書ファイルに保存する。note には接続しない（既定・推奨）
#   draft   … note に非公開の下書きとして保存する。公開はCEOが note 上で行う
#   publish … CEOが承認したらサーバーが note に公開する
# file 以外は note の非公開エンドポイントを使います。予告なく変わる可能性があり、
# 自分のアカウントに自分の記事を投稿する用途に限ってください。
NOTE_OUTPUT=file

# draft / publish のときだけ必要。
# note.com にログイン → 開発者ツール → Application → Cookies →
# note_gql_auth_token の値をコピー
NOTE_AUTH_TOKEN=
NOTE_SESSION=

# ── Supabase（会社の状態の保存先）────────────────────────────────────────
# 未設定でも動きます（.friday/ にファイル保存）。ただしサーバーレス（Vercel）では
# 書き込み先が実行インスタンスごとに分かれて消えるため、本番では必須です。
#
# 取得手順: Supabase のプロジェクト → Settings → API Keys
#   Project URL                    → SUPABASE_URL
#   Secret keys の default（sb_secret_…）→ SUPABASE_SERVICE_ROLE_KEY
#
# Publishable key（sb_publishable_…）では動きません。あれはブラウザ用で、
# RLS を迂回できないため読み書きできません。
# secret / service_role キーは RLS を迂回します。サーバー専用で、ブラウザには
# 絶対に渡さないでください（NEXT_PUBLIC_ を付けない）。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 旧 service_role でも新 secret key でも可。こちらの名前でも受け付けます。
# SUPABASE_SECRET_KEY=

# ── 定期実行 ──────────────────────────────────────────────────────────────
# 毎日の仕事は /api/cron が発火させます。ジョブはJSTの日付で重複排除されるため、
# 何度叩いても1日1回しか実行されません。
#   Vercel     … vercel.json の cron（08:00 UTC = 17:00 JST）
#   ローカル    … ダッシュボードを開いている間、3分ごとにポーリング
#   手動       … NOTE DRAFTS の「今すぐ書く」、または curl localhost:3000/api/cron
#
# 本番で /api/cron を公開したくない場合に設定します（Vercel Cron は自動で付与）。
CRON_SECRET=
