# ── Live AI employees ───────────────────────────────────────────────────────
# Without this the dashboard runs in demo mode: AI activity is simulated and no
# API calls are made. With it, AI employees actually run — they call Claude,
# use tools, and write their results back into the company state.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Model the C-suite and report authors run on.
FRIDAY_MODEL=claude-opus-5
# Model specialists run on when work is delegated to them. Defaults to
# FRIDAY_MODEL. Set claude-sonnet-5 to spend less on delegated work.
FRIDAY_WORKER_MODEL=

# Real web search / page reading for the research-capable employees.
FRIDAY_WEB_TOOLS=true
# Real code execution for the analysis-capable employees.
FRIDAY_CODE_EXECUTION=true

# Safety rails on a single run.
FRIDAY_MAX_STEPS=24
FRIDAY_MAX_DELEGATIONS=5

# Where the company's working state is persisted (relative to the project root).
FRIDAY_DATA_DIR=.friday

# ── Google（Gmail + Calendar）─────────────────────────────────────────────
# 設定すると、email / calendar を持つAI社員が実際に受信箱とカレンダーを読み、
# CEOの承認を経てメール送信と打ち合わせ設定を行います。未設定なら該当ツールは
# 配布されず、他の機能はそのまま動きます。
#
# 取得手順（Settings 画面にも同じ手順があります）:
#  1. console.cloud.google.com でプロジェクトを作り、Gmail API と
#     Google Calendar API を有効化する
#  2. OAuth 同意画面を設定し、自分のアカウントをテストユーザーに追加する
#  3. 認証情報 → OAuth クライアントID（デスクトップアプリ）を作成する
#  4. 次のスコープでリフレッシュトークンを取得する:
#       https://www.googleapis.com/auth/gmail.readonly
#       https://www.googleapis.com/auth/gmail.send
#       https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 送信元アドレス。空なら認証したアカウントのアドレスが使われます。
# 表示名を付けるなら: Re-Palette <you@example.com>
GOOGLE_SEND_AS=
# 使用するカレンダー。既定は認証したアカウントのメインカレンダー。
GOOGLE_CALENDAR_ID=primary

# ── note（記事の自動執筆）──────────────────────────────────────────────────
# 設定不要で動きます。Content AI が毎日 NOTE_DAILY_DRAFT_AT（JST）に記事を1本書き、
# Markdown の文書ファイルとして保存します。ダッシュボードの NOTE DRAFTS から
# 全文をコピーするか .md をダウンロードして、note に貼り付けてください。
NOTE_DAILY_DRAFT_AT=17:00

# 出力先。note には記事投稿の公式APIがないため、既定は file です。
#   file    … 文書ファイルに保存する。note には接続しない（既定・推奨）
#   draft   … note に非公開の下書きとして保存する。公開はCEOが note 上で行う
#   publish … CEOが承認したらサーバーが note に公開する
# file 以外は note の非公開エンドポイントを使います。予告なく変わる可能性があり、
# 自分のアカウントに自分の記事を投稿する用途に限ってください。
NOTE_OUTPUT=file

# draft / publish のときだけ必要。
# note.com にログイン → 開発者ツール → Application → Cookies →
# note_gql_auth_token の値をコピー
NOTE_AUTH_TOKEN=
NOTE_SESSION=

# ── Supabase（会社の状態の保存先）────────────────────────────────────────
# 未設定でも動きます（.friday/ にファイル保存）。ただしサーバーレス（Vercel）では
# 書き込み先が実行インスタンスごとに分かれて消えるため、本番では必須です。
#
# 取得手順: Supabase のプロジェクト → Settings → API
#   Project URL          → SUPABASE_URL
#   service_role（secret）→ SUPABASE_SERVICE_ROLE_KEY
#
# service_role キーは RLS を迂回します。サーバー専用で、ブラウザには絶対に
# 渡さないでください（NEXT_PUBLIC_ を付けない）。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 定期実行 ──────────────────────────────────────────────────────────────
# 毎日の仕事は /api/cron が発火させます。ジョブはJSTの日付で重複排除されるため、
# 何度叩いても1日1回しか実行されません。
#   Vercel     … vercel.json の cron（08:00 UTC = 17:00 JST）
#   ローカル    … ダッシュボードを開いている間、3分ごとにポーリング
#   手動       … NOTE DRAFTS の「今すぐ書く」、または curl localhost:3000/api/cron
#
# 本番で /api/cron を公開したくない場合に設定します（Vercel Cron は自動で付与）。
CRON_SECRET=
